{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=booking_db;Username=postgres;Password=postgres;Port=5433"
},
  "Services": {
    "RoomManagementServiceUrl": "http://room-management-service:80", 
    "PaymentServiceUrl": "http://payment-service:80"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "WriteTo": [
      { "Name": "Console", "Args": { "theme": "Serilog.Sinks.SystemConsole.Themes.Ansi(mediumEmphasisTheme)" } }
    ]
  }
}

