{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=booking_db;Username=postgres;Password=postgres;Port=5433"
  },
  "Services": {
    "RoomManagementServiceUrl": "http://room-management-service:80",
    "PaymentServiceUrl": "http://payment-service:80"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "WriteTo": [
      { "Name": "Console", "Args": { "theme": "Serilog.Sinks.SystemConsole.Themes.Ansi(mediumEmphasisTheme)" } }
    ]
  },
  "Kratos": {
    "WebhookSecret": "Bearer 5f8a2b9e-7c4d-4e3a-912f-6b2c8a1d3f9e"
  }
}
